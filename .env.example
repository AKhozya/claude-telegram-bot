# Claude Telegram Bot - Environment Configuration

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=123456789

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# Working directory where Claude runs (loads CLAUDE.md, skills, MCP config)
CLAUDE_WORKING_DIR=/Users/yourname/personal

# Alternate Bot API server. The public API caps a download at 20MB and a send at 50MB; a
# self-hosted server raises the download ceiling to 2GB. Every api/ctx.api call follows this.
# TELEGRAM_API_ROOT=http://localhost:8081

# ==============================================================================
# OPTIONAL - Security
# ==============================================================================

# Comma-separated paths Claude can access
# Default: working dir, ~/Documents, ~/Downloads, ~/Desktop, ~/.claude
# Note: Setting this OVERRIDES defaults. Include ~/.claude for plan mode to work.
# ALLOWED_PATHS=/Users/yourname/personal,/Users/yourname/projects,/Users/yourname/.claude

# OS-level Bash sandbox (Seatbelt on macOS, bubblewrap on Linux), fail-closed and ON by default.
# Set to false ONLY where bubblewrap can't get unprivileged user namespaces — e.g. a hardened
# container (seccomp=RuntimeDefault, caps dropped), where the pod itself is the sandbox. Leaving it
# on there makes every Bash command fail-closed. Any value other than false/0/off/no keeps it on.
# BASH_SANDBOX_ENABLED=true

# Rate limiting (token bucket)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60

# Absolute path to an external Bash denylist, run from bot code after the built-in checks pass.
# If unset, that layer is off. If set, the script is authoritative: any failure to get exit 0
# from it denies the Bash call, so a bad path blocks Bash rather than letting it through.
# The image ships one and the deployment points here.
# SAFETY_HOOK=/app/hooks/validate-safe-bash.sh

# ==============================================================================
# OPTIONAL - Claude Authentication
# ==============================================================================

# API key for environments without Claude Code CLI auth
# Get from: https://console.anthropic.com/
# Note: API usage is billed per token - CLI auth is more cost-effective
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Path to Claude CLI (auto-detected from PATH by default)
# CLAUDE_CODE_PATH=/usr/local/bin/claude

# The SDK child consumes these two; this code only reads them so the log redactor can scrub
# them. Leave unset when the CLI is already authenticated.
# ANTHROPIC_AUTH_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN=

# ==============================================================================
# OPTIONAL - Extended Thinking
# ==============================================================================

# Keywords that trigger extended thinking (comma-separated, case-insensitive)
# THINKING_KEYWORDS=think,pensa,ragiona

# Keywords that trigger deep thinking (50k tokens)
# THINKING_DEEP_KEYWORDS=ultrathink,think hard,pensa bene

# ==============================================================================
# OPTIONAL - Logging
# ==============================================================================

# Audit log path
# AUDIT_LOG_PATH=/tmp/claude-telegram-audit.log

# Output audit logs as JSON (default: human-readable)
# AUDIT_LOG_JSON=false

# The bot touches this file after every successful getUpdates. A container livenessProbe
# reads its mtime to tell a wedged poller from a live one, so the probe command must name
# the same path.
# POLL_HEARTBEAT_PATH=/tmp/claude-telegram-poll-heartbeat

# ==============================================================================
# OPTIONAL - Runtime files
# ==============================================================================

# Session history behind /resume, and the chat/message ids /restart uses to edit its own
# status message after the process comes back.
# SESSION_FILE_PATH=/tmp/claude-telegram-session.json
# RESTART_FILE_PATH=/tmp/claude-telegram-restart.json

# Downloads, extracted PDF pages and archives, video frames, and the .wav that
# transcription derives from each media file.
# TEMP_DIR=/tmp/telegram-bot

# Nothing else clears TEMP_DIR. In a container /tmp lives as long as the pod, so downloads
# accumulate for its whole lifetime without this sweep.
# TEMP_REAP_INTERVAL_MS=3600000

# How old a file must be before the sweep takes it. An ask_user pause holds a downloaded
# file open until the user taps a button, and Claude re-reads it then. A pause that outlasts
# this window loses the file.
# TEMP_RETENTION_HOURS=24

# ==============================================================================
# OPTIONAL - HTTP Trigger
# ==============================================================================

# Lets external systems POST a prompt that the bot processes as if the first
# allowed user sent it via Telegram. Disabled unless TRIGGER_SECRET is set.
# Bound to TRIGGER_HOST (default 127.0.0.1) — keep loopback unless you also
# add network controls (firewall / NetworkPolicy).
#
# Usage:
#   curl -fsS -X POST http://127.0.0.1:8080/trigger \
#     -H "X-Trigger-Secret: $TRIGGER_SECRET" \
#     -H "Content-Type: application/json" \
#     -d '{"prompt":"Review alerts and clean up stale stuff"}'
#
# TRIGGER_SECRET=
# TRIGGER_PORT=8080
# TRIGGER_HOST=127.0.0.1

# ==============================================================================
# OPTIONAL - Transcription
# ==============================================================================

# Voice notes, audio files, and the audio track of videos.
# WHISPER_MODEL=/usr/local/share/whisper/ggml-small.bin  # baked into the container image
# WHISPER_THREADS=2                                      # match the container's CPU limit
# TRANSCRIBE_MAX_DURATION_SECONDS=600                    # clips longer than this are refused
# WHISPER_SILENCE_DB=-76                                 # move this if you change WHISPER_MODEL
